<Window x:Class="NetworkScanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkScanner.Views"
        xmlns:viewModels="clr-namespace:NetworkScanner.ViewModels"
        mc:Ignorable="d"
        Title="Network Scanner" Height="600" Width="800">
    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IP Range Selection -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="IP Range:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding IpRanges}" 
                      SelectedItem="{Binding SelectedIpRange}"
                      Width="120" Margin="0,0,10,0"/>
            <TextBlock Text="Base IP:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox Text="{Binding BaseIp}" Width="120" Margin="0,0,10,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{Binding ScanButtonText}" 
                    Command="{Binding ScanCommand}"
                    Width="100" Margin="0,0,10,0"
                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"/>
            <Button Content="Clear" 
                    Command="{Binding ClearCommand}"
                    Width="100"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,0,0,10"/>

        <!-- Results -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding DevicesView}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="150"/>
                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="200"/>
                <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Text="Network Scanner v1.0" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>